<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Pedido de Compra" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0000000000001252"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT
/*####################################
  ############ CABEÇALHO #############
  ####################################*/
EMP.RAZAOSOCIAL AS "EMPRESA",
(SELECT E.TIPO FROM TSIEND E WHERE E.CODEND = EMP.CODEND) AS "TIPO ENDEREÇO",
(SELECT E.NOMEEND FROM TSIEND E WHERE E.CODEND = EMP.CODEND) AS "ENDEREÇO",
(SELECT B.NOMEBAI FROM TSIBAI B WHERE B.CODBAI = EMP.CODBAI) AS "BAIRRO",
(SELECT C.NOMECID FROM TSICID C WHERE C.CODCID = EMP.CODCID) AS "CIDADE",
(SELECT U.UF FROM TSIUFS U, TSICID C WHERE C.CODCID = EMP.CODCID AND U.CODUF = C.UF) AS "UF",
EMP.CODEMP AS "COD EMPRESA",
EMP.NUMEND AS "NUM ENDEREÇO",
EMP.COMPLEMENTO AS "COMPLEMENTO",
FC_MASKCEP(EMP.CEP) AS "CEP",
FC_MASKCPFCNPJ(2, EMP.CGC) AS "CNPJ",
EMP.INSCESTAD AS "INSCRIÇÃO ESTADUAL",
EMP.HOMEPAGE AS "SITE",
TOP.CODTIPOPER AS "CODTOP",
TOP.DESCROPER AS "TOP",
CAB.NUMNOTA AS "NRO. NOTA",
CAB.DTNEG AS "DT NEGOCIAÇÃO",
/*####################################
  ######### DADOS FORNECEDOR #########
  ####################################*/
PAR.RAZAOSOCIAL AS "PARCEIRO",
PAR.EMAIL AS "PARC EMAIL",
FC_MASKFONE(PAR.TELEFONE) AS "PARC TELEFONE",
(SELECT E2.TIPO FROM TSIEND E2 WHERE E2.CODEND = PAR.CODEND) AS "PARC TIPO ENDEREÇO",
(SELECT E2.NOMEEND FROM TSIEND E2 WHERE E2.CODEND = PAR.CODEND) AS "PARC ENDEREÇO",
(SELECT B2.NOMEBAI FROM TSIBAI B2 WHERE B2.CODBAI = PAR.CODBAI) AS "PARC BAIRRO",
(SELECT C2.NOMECID FROM TSICID C2 WHERE C2.CODCID = PAR.CODCID) AS "PARC CIDADE",
(SELECT U2.UF FROM TSIUFS U2, TSICID C2 WHERE C2.CODCID = PAR.CODCID AND U2.CODUF = C2.UF) AS "PARC UF",
PAR.NUMEND AS "PARC NUMERO END",
PAR.COMPLEMENTO AS "PARC COMPLEMENTO",
FC_MASKCEP(PAR.CEP) AS "PARC CEP",
FC_MASKCPFCNPJ(2, PAR.CGC_CPF) AS "PARC CNPJ",
PAR.IDENTINSCESTAD AS "PARC INSCRIÇÃO ESTADUAL",
/*####################################
  ######### DADOS FATURAMENTO ########
  ####################################*/
FAT.RAZAOSOCIAL AS "FATURAMENTO",
FAT.EMAIL AS "FAT EMAIL",
FC_MASKFONE(FAT.TELEFONE) AS "FAT TELEFONE",
(SELECT E2.TIPO FROM TSIEND E2 WHERE E2.CODEND = FAT.CODEND) AS "FAT TIPO ENDEREÇO",
(SELECT E2.NOMEEND FROM TSIEND E2 WHERE E2.CODEND = FAT.CODEND) AS "FAT ENDEREÇO",
(SELECT B2.NOMEBAI FROM TSIBAI B2 WHERE B2.CODBAI = FAT.CODBAI) AS "FAT BAIRRO",
(SELECT C2.NOMECID FROM TSICID C2 WHERE C2.CODCID = FAT.CODCID) AS "FAT CIDADE",
(SELECT U2.UF FROM TSIUFS U2, TSICID C2 WHERE C2.CODCID = FAT.CODCID AND U2.CODUF = C2.UF) AS "FAT UF",
FAT.NUMEND AS "FAT NUMERO END",
FAT.COMPLEMENTO AS "FAT COMPLEMENTO",
FC_MASKCEP(FAT.CEP) AS "FAT CEP",
FC_MASKCPFCNPJ(2, FAT.CGC_CPF) AS "FAT CNPJ",
FAT.IDENTINSCESTAD AS "FAT INSCRIÇÃO ESTADUAL",
/*####################################
  ######### DADOS DESTINATARIO #######
  ####################################*/
DES.RAZAOSOCIAL AS "DESTINATARIO",
DES.EMAIL AS "DEST EMAIL",
FC_MASKFONE(DES.TELEFONE) AS "DEST TELEFONE",
(SELECT E2.TIPO FROM TSIEND E2 WHERE E2.CODEND = DES.CODEND) AS "DEST TIPO ENDEREÇO",
(SELECT E2.NOMEEND FROM TSIEND E2 WHERE E2.CODEND = DES.CODEND) AS "DEST ENDEREÇO",
(SELECT B2.NOMEBAI FROM TSIBAI B2 WHERE B2.CODBAI = DES.CODBAI) AS "DEST BAIRRO",
(SELECT C2.NOMECID FROM TSICID C2 WHERE C2.CODCID = DES.CODCID) AS "DEST CIDADE",
(SELECT U2.UF FROM TSIUFS U2, TSICID C2 WHERE C2.CODCID = DES.CODCID AND U2.CODUF = C2.UF) AS "DEST UF",
DES.NUMEND AS "DEST NUMERO END",
DES.COMPLEMENTO AS "DEST COMPLEMENTO",
FC_MASKCEP(DES.CEP) AS "DEST CEP",
FC_MASKCPFCNPJ(2, DES.CGC_CPF) AS "DEST CNPJ",
DES.IDENTINSCESTAD AS "DEST INSCRIÇÃO ESTADUAL",
/*####################################
  ########### DADOS ITENS ############
  ####################################*/
ITE.SEQUENCIA AS "SEQUENCIA",
PRO.REFERENCIA AS "REFERENCIA",
PRO.DESCRPROD AS "DESCRIÇÃO PRODUTO",
ITE.CONTROLE AS "CONTROLE",
ITE.CODVOL AS "UN",
ITE.QTDNEG AS "QTD ITENS",
ITE.VLRUNIT AS "VLR UNITARIO",
ITE.ALIQIPI AS "ALIQ IP",
ITE.VLRIPI AS "VLR IPI",
ITE.ALIQICMS AS "ALIQ ICMS",
ITE.VLRICMS AS "VLR ICMS",
ITE.PERCDESC AS "PORC. DESCONTO",
ITE.VLRDESC AS "DESCONTO",
(ITE.VLRUNIT*ITE.QTDNEG) AS "VLR TOTAL",
(ITE.VLRTOT-ITE.VLRDESC) AS "VLR TOTAL DESCONTO",
CAB.VLRIPI AS "VALOR TOTAL IPI",
CAB.VLRICMS AS "VALOR TOTAL ICMS",
CAB.VLRNOTA AS "VALOR TOTAL NOTA",
CAB.VLRDESCTOTITEM AS "VALOR TOTAL DESCONTO",
(CAB.VLRNOTA-CAB.VLRIPI) AS "VALOR TOTAL S/ IPI",
/*####################################
  ####### DADOS COMPLEMENTARES #######
  ####################################*/
TPV.DESCRTIPVENDA AS "TIPO NEGOCIAÇÃO",
VEN.APELIDO AS "COMPRADOR",
CAB.DTPREVENT AS "DT ENTREGA",
CAB.AD_PREVFAT AS "DT FATURAMENTO",
EMP.EMAIL AS "EMAIL",
FC_MASKFONE(EMP.TELEFONE) AS "TELEFONE",
(CASE WHEN CAB.CIF_FOB = 'C' THEN 'CIF'
      WHEN CAB.CIF_FOB = 'F' THEN 'FOB'
      WHEN CAB.CIF_FOB = 'S' THEN 'SEM FRETE'
      WHEN CAB.CIF_FOB = 'T' THEN 'TERCEIROS' END) AS "CIF FOB",
(SELECT P.NOMEPARC FROM TGFPAR P WHERE P.CODPARC = CAB.CODPARCTRANSP) AS "TRANSPORTADORA",
(SELECT P2.REFERENCIA FROM TGFPRO P2 WHERE P2.CODPROD = CAB.AD_NROSERIE) AS "NRO. SERIE",
PRJ.IDENTIFICACAO AS "PROJETO",
CAB.OBSERVACAO AS "OBSERVAÇÃO",
CASE WHEN CAB.CODTIPOPER NOT IN (2020,2001,2002) THEN '*PRODUTO DESTINADO PARA INDUSTRIALIZAÇÃO, CFOP: 6102' END AS INFO
FROM TGFCAB CAB
INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA
LEFT JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
LEFT JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP
LEFT JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
LEFT JOIN TGFTOP TOP ON TOP.CODTIPOPER = CAB.CODTIPOPER
LEFT JOIN TCSPRJ PRJ ON PRJ.CODPROJ = CAB.CODPROJ
LEFT JOIN TGFVEN VEN ON VEN.CODVEND = CAB.CODVEND
LEFT JOIN TGFTPV TPV ON TPV.CODTIPVENDA = CAB.CODTIPVENDA AND TPV.DHALTER = CAB.DHTIPVENDA
LEFT JOIN TGFPAR FAT ON FAT.CODPARC = NVL(CAB.AD_CODPARCFAT, CAB.CODEMP)
LEFT JOIN TGFPAR DES ON DES.CODPARC = NVL(CAB.CODPARCDEST, CAB.CODEMP)
WHERE CAB.NUNOTA = 3939
AND CAB.TIPMOV = 'O'
ORDER BY ITE.SEQUENCIA]]>
	</queryString>
